# Swell — Lead Command (multi-tenant)
# Copy to .env locally; in Replit, set these in Secrets.

PORT=3000
NODE_ENV=development

# Apex domain for tenant subdomain routing (no protocol)
SWELL_APEX_DOMAIN=nopressurelaunch.com

# REQUIRED in prod — random 32+ char string used to sign auth cookies
SWELL_COOKIE_SECRET=change-me-to-something-long-and-random

# Super admin secret for systemadmin.nopressurelaunch.com
SWELL_ADMIN_SECRET=change-me-to-a-strong-admin-password

# Anthropic (Hayden, the AI SMS responder). Sonnet primary by default.
ANTHROPIC_API_KEY=

# Nurture cron tick interval in ms (default 60000 = 1 minute)
NURTURE_TICK_MS=60000

# Comma-separated list of tenant env-prefixes to seed
SWELL_TENANTS=HARRIS_BROS,MACKWASH

# ─── Facebook (single Meta app for all tenants) ──────────────────────────────
FACEBOOK_WEBHOOK_VERIFY_TOKEN=replace-with-random-token
# Optional fallback token if a tenant hasn't supplied its own
FACEBOOK_PAGE_ACCESS_TOKEN=

# ─── Twilio (global default; tenants can override their from-number) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ─── VAPI (AI voice calls — same number as SMS per tenant) ──────────────────
VAPI_API_KEY=
HARRIS_BROS_VAPI_ASSISTANT_ID=
MACKWASH_VAPI_ASSISTANT_ID=

# ─── Tenant: Harris Bros ─────────────────────────────────────────────────────
HARRIS_BROS_NAME=Harris Brothers
HARRIS_BROS_SLUG=harrisbrosads
HARRIS_BROS_PASSWORD=set-a-strong-password
HARRIS_BROS_BRAND_COLOR=#fbbf24
HARRIS_BROS_CONTACT_PHONE=+1...
HARRIS_BROS_TWILIO_FROM=
HARRIS_BROS_FB_FORM_IDS=
HARRIS_BROS_FB_PAGE_IDS=
HARRIS_BROS_FB_PAGE_TOKEN=

# ─── Tenant: Mack Wash ───────────────────────────────────────────────────────
MACKWASH_NAME=Mack Wash
MACKWASH_SLUG=mackwash
MACKWASH_PASSWORD=set-a-strong-password
MACKWASH_BRAND_COLOR=#fbbf24
MACKWASH_CONTACT_PHONE=+14708741267
MACKWASH_TWILIO_FROM=
MACKWASH_FB_FORM_IDS=
MACKWASH_FB_PAGE_IDS=100094353285077
MACKWASH_FB_PAGE_TOKEN=

# Path to SQLite file (Replit: persistent storage path)
DATABASE_PATH=./data/swell.db
